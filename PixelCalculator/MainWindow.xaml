<Window x:Class="PixelCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="像素计算器 (Pixel Calculator)" Height="430" Width="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F4F4F5"
        Icon="logo.ico">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：画面比例选择区 -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="6">
            <DockPanel>
                <TextBlock Text="画面比例选择" DockPanel.Dock="Top" FontSize="12" FontWeight="Bold" Foreground="#27272A" Margin="4,2,4,6" HorizontalAlignment="Center"/>
                <ListBox ItemsSource="{Binding Ratios}" SelectedItem="{Binding SelectedRatio}" 
                         BorderThickness="0" Background="Transparent" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1.5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <RadioButton IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                     Style="{StaticResource {x:Type ToggleButton}}"
                                                     HorizontalContentAlignment="Stretch" Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 普通比例项：显示固定文本名称 -->
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#3F3F46">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 自定义比例项：两个输入框 + 中间一个 "x" -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBox Text="{Binding CustomWidthText, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="24" Height="22" MaxLength="2"
                                                             TextAlignment="Center" VerticalContentAlignment="Center"
                                                             FontSize="11" Padding="0" BorderBrush="#D4D4D8"
                                                             PreviewTextInput="CustomRatioTextBox_PreviewTextInput"
                                                             PreviewMouseDown="CustomRatioTextBox_PreviewMouseDown"
                                                             GotFocus="CustomRatioTextBox_GotFocus"
                                                             DataObject.Pasting="CustomRatioTextBox_Pasting"/>
                                                    <TextBlock Text="x" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" Margin="2,0"/>
                                                    <TextBox Text="{Binding CustomHeightText, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="24" Height="22" MaxLength="2"
                                                             TextAlignment="Center" VerticalContentAlignment="Center"
                                                             FontSize="11" Padding="0" BorderBrush="#D4D4D8"
                                                             PreviewTextInput="CustomRatioTextBox_PreviewTextInput"
                                                             PreviewMouseDown="CustomRatioTextBox_PreviewMouseDown"
                                                             GotFocus="CustomRatioTextBox_GotFocus"
                                                             DataObject.Pasting="CustomRatioTextBox_Pasting"/>
                                                </StackPanel>

                                                <!-- 右侧几何矩形预览 -->
                                                <Grid Grid.Column="1" Width="36" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border BorderBrush="#71717A" BorderThickness="1.5" CornerRadius="1" Background="#E4E4E7"
                                                            Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" 
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </RadioButton>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧：参数联动换算区 -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="像素参数联动" FontSize="12" FontWeight="Bold" Foreground="#27272A" Margin="0,0,0,12"/>

                <!-- 宽度输入 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="宽度 (像素)" FontSize="11" Foreground="#71717A" Margin="2,0,0,4"/>
                    <Grid Grid.Row="1">
                        <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                 PreviewTextInput="IntegerTextBox_PreviewTextInput" TextChanged="TextBox_TextChanged"
                                 Height="28" VerticalContentAlignment="Center" Padding="6,0,26,0" BorderBrush="#D4D4D8"/>
                        <TextBlock Text="px" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- 高度输入 -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="高度 (像素)" FontSize="11" Foreground="#71717A" Margin="2,0,0,4"/>
                    <Grid Grid.Row="1">
                        <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                 PreviewTextInput="IntegerTextBox_PreviewTextInput" TextChanged="TextBox_TextChanged"
                                 Height="28" VerticalContentAlignment="Center" Padding="6,0,26,0" BorderBrush="#D4D4D8"/>
                        <TextBlock Text="px" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- 分辨率输入 -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="分辨率 (百万像素)" FontSize="11" Foreground="#71717A" Margin="2,0,0,4"/>
                    <Grid Grid.Row="1">
                        <TextBox Text="{Binding MegapixelsRaw, UpdateSourceTrigger=PropertyChanged}" 
                                 PreviewTextInput="DecimalTextBox_PreviewTextInput" TextChanged="TextBox_TextChanged"
                                 Height="28" VerticalContentAlignment="Center" Padding="6,0,30,0" BorderBrush="#D4D4D8"/>
                        <TextBlock Text="MP" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- 底部信息汇总卡片 -->
                <Border Grid.Row="5" Background="#FAFAFA" CornerRadius="4" BorderBrush="#F4F4F5" BorderThickness="1" Padding="8,10">
                    <StackPanel>
                        <TextBlock Text="总像素数量" FontSize="10" Foreground="#71717A" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPixelsDisplay}" FontSize="15" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="修改任意数值，实时自动换算其他两项" FontSize="9" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 作者与版本信息 -->
                <TextBlock Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,6,2,0">
                    <Hyperlink NavigateUri="https://github.com/tpz9911"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               ToolTip="点击访问作者主页">
                        PZ v0.99.260918
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>